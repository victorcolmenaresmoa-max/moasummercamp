# ============================================================================
# MOA READING LAB — Environment variables
# Copy this file to .env.local for local development and add the same values
# in Vercel under Project Settings > Environment Variables.
# ============================================================================

# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server only. Never expose this key with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- AI report generation only (participants use Gemini externally) ----
GEMINI_API_KEY=AIza...
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# ---- Camp ----
# Code participants must enter during sign-up.
# Preferred for Google registration (server-only):
CAMP_CODE=MOA2026
# Backward-compatible with existing Vercel deployments:
NEXT_PUBLIC_CAMP_CODE=MOA2026

# ---- Telegram checkpoint alerts ----
# Create the bot with @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# One or more Telegram chat IDs separated by commas.
# Example with two private chats and one private staff group:
# TELEGRAM_CHAT_IDS=123456789,987654321,-1001234567890
TELEGRAM_CHAT_IDS=123456789
