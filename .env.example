# ============================================================================
# MOA READING LAB — variables de entorno
# Copia este archivo como .env.local (desarrollo) y replicalo en Vercel
# (Project Settings > Environment Variables) para produccion.
# ============================================================================

# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key: SOLO servidor. Nunca uses el prefijo NEXT_PUBLIC_ aqui.
# Sin ella, /api/ai/report NO puede guardar el reporte.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- IA (Google Gemini) ----
# Consiguela en https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Opcional. Por defecto gemini-2.5-flash (rapido y barato).
# Para evaluaciones mas exigentes: gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# ---- Camp ----
# Codigo que los participantes escriben al registrarse (evita registros externos)
NEXT_PUBLIC_CAMP_CODE=MOA2026
